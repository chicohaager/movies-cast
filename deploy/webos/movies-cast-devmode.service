[Unit]
Description=Renew the LG TV Developer Mode session (keeps the movies-cast TV app installed)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The account that owns DEVMODE_DIR (its files are 0600).
User=CHANGE_ME
Environment=DEVMODE_DIR=/DATA/AppData/movies-cast-devmode
ExecStart=/DATA/AppData/movies-cast-devmode/renew-devmode.sh
