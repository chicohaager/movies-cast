<?xml version="1.0" encoding="utf-8"?>
<!-- The ZimaOS gateway speaks plain HTTP in the home network, and the server address is
     whatever the owner types; so cleartext cannot be limited to a list of hosts. -->
<network-security-config>
<!-- A server in the home network often has a certificate its owner made (self-signed, or of an
     authority of their own). Such a certificate counts once the owner installed it in Android's
     settings; Jellyfin's own Android clients do the same. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
